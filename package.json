{
  "name": "testcraft",
  "version": "0.1.0",
  "private": true,
  "description": "AI-driven mobile test automation that generates Appium specs from Zephyr cases, executes them on BrowserStack across Android and iOS, and auto-heals failing tests with LLM-powered fixes",
  "type": "module",
  "scripts": {
    "generate:tests": "tsx scripts/generate-tests.ts",
    "test:android": "wdio run src/runner/wdio.android.conf.ts",
    "test:ios": "wdio run src/runner/wdio.ios.conf.ts",
    "fix": "tsx scripts/auto-fix.ts",
    "report:slack": "tsx scripts/send-slack-report.ts",
    "tui": "tsx scripts/tui.ts",
    "validate:tests": "tsx scripts/validate-tests.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@wdio/browserstack-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/json-reporter": "^9.20.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "chai": "^5.0.0",
    "dotenv": "^16.0.0",
    "neo-blessed": "^0.2.0",
    "openai": "^4.0.0",
    "pino": "^9.0.0",
    "tsx": "^4.0.0",
    "webdriverio": "^9.0.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/chai": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
