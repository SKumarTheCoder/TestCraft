# ─────────────────────────────────────────────
# Mobile Test Automation — Environment Config
# ─────────────────────────────────────────────

# ── AI Provider (choose one) ────────────────
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# LLM model override (defaults: gpt-4o / claude-sonnet-4)
TEST_GENERATION_MODEL=
AUTO_FIX_MODEL=

# ── Jira / Zephyr Scale ─────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
ZEPHYR_PROJECT_KEY=PROJ

# ── BrowserStack ────────────────────────────
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_APP_ID=                  # Optional: static if pre-uploaded

# ── Slack ───────────────────────────────────
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#mobile-test-results

# ── Validation ──────────────────────────────
VALIDATE_GENERATED_TESTS=false      # Run + auto-fix tests on BrowserStack after generation
VALIDATION_MAX_RETRIES=3            # Max retry attempts during validation loop
TEST_RESULTS_DIR=./test-results
